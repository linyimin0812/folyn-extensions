        "icon": "📋",
        "window": true,
        "entry": "index.html"
      }
    ],
    "exporters": [],
    "fileTemplates": [],
    "keybindings": [],
    "exportEnhancers": [],
    "markdownCodeRenderers": [],
    "editorLanguages": []
  }
